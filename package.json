{
  "name": "dsh-clamawake",
  "version": "0.1.3",
  "private": false,
  "description": "ClamAwake keep-alive for DeepSeek Harness (macOS): binds the lid-closed keep-alive recipe (virtual display + caffeinate -d) to the host lifecycle. Self-contained — ships the engine, no separate app required. Reuses an existing keepalive display; restarts a crashed engine with backoff.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE",
    "NOTICE",
    "bin/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangweijian97/dsh-clamawake.git"
  },
  "homepage": "https://github.com/zhangweijian97/dsh-clamawake",
  "bugs": {
    "url": "https://github.com/zhangweijian97/dsh-clamawake/issues"
  },
  "author": {
    "name": "zhangweijian97",
    "url": "https://github.com/zhangweijian97"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "macos",
    "clamshell",
    "keepalive",
    "clamawake",
    "virtual-display"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "os": [
    "darwin"
  ]
}
