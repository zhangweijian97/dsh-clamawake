{
  "name": "dsh-clamawake",
  "version": "0.1.0",
  "private": false,
  "description": "Bind the ClamAwake lid-closed keep-alive recipe to the DeepSeek Harness host lifecycle: host start = virtual display + caffeinate -d running; host stop = its own children terminated; an existing keepalive display is reused, and a crashed engine is restarted with backoff. Requires a macOS machine with ClamAwake installed.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangweijian97/dsh-clamawake.git"
  },
  "homepage": "https://github.com/zhangweijian97/dsh-clamawake",
  "bugs": {
    "url": "https://github.com/zhangweijian97/dsh-clamawake/issues"
  },
  "author": {
    "name": "zhangweijian97",
    "url": "https://github.com/zhangweijian97"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "macos",
    "clamshell",
    "keepalive",
    "clamawake",
    "virtual-display"
  ],
  "engines": {
    "dsh": ">=0.2.0"
  },
  "os": [
    "darwin"
  ]
}
